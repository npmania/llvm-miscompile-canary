set(_rv "riscv64-unknown-linux-gnu")
set(LLVM_BUILTIN_TARGETS "default;${_rv}" CACHE STRING "" FORCE)
set(LLVM_RUNTIME_TARGETS "default;${_rv}" CACHE STRING "" FORCE)

set(_rv_compile_flags "")
set(_rv_link_flags "")
if(EXISTS "/usr/riscv64-linux-gnu/lib/libc.so")
  file(READ "/usr/riscv64-linux-gnu/lib/libc.so" _rv_libc)
  if(NOT _rv_libc MATCHES "/usr/riscv64-linux-gnu" AND (_rv_libc MATCHES "/lib/ld-linux-riscv64" OR _rv_libc MATCHES "/usr/lib64/"))
    set(_rv_compile_flags "--sysroot=/usr/riscv64-linux-gnu --gcc-toolchain=/usr")
    set(_rv_link_flags "${_rv_compile_flags}")
    foreach(_rv_libdir IN ITEMS "lib" "lib64")
      file(GLOB _rv_crt LIST_DIRECTORIES false "/usr/${_rv_libdir}/gcc/riscv64-linux-gnu/*/crtbeginS.o")
      if(_rv_crt)
        list(SORT _rv_crt COMPARE NATURAL)
        list(GET _rv_crt -1 _rv_best_crt)
        get_filename_component(_rv_gcc_dir "${_rv_best_crt}" DIRECTORY)
        set(_rv_link_flags "${_rv_link_flags} -B${_rv_gcc_dir} -L${_rv_gcc_dir}")
        break()
      endif()
    endforeach()
  endif()
endif()

set(BUILTINS_${_rv}_CMAKE_SYSTEM_NAME "Linux" CACHE STRING "" FORCE)
set(BUILTINS_${_rv}_CMAKE_SYSTEM_PROCESSOR "riscv64" CACHE STRING "" FORCE)
set(BUILTINS_${_rv}_CMAKE_C_FLAGS "${_rv_compile_flags}" CACHE STRING "" FORCE)
set(BUILTINS_${_rv}_CMAKE_CXX_FLAGS "${_rv_compile_flags}" CACHE STRING "" FORCE)
set(BUILTINS_${_rv}_CMAKE_EXE_LINKER_FLAGS "-fuse-ld=lld ${_rv_link_flags}" CACHE STRING "" FORCE)
set(BUILTINS_${_rv}_CMAKE_SHARED_LINKER_FLAGS "-fuse-ld=lld ${_rv_link_flags}" CACHE STRING "" FORCE)
set(BUILTINS_${_rv}_CMAKE_MODULE_LINKER_FLAGS "-fuse-ld=lld ${_rv_link_flags}" CACHE STRING "" FORCE)

set(RUNTIMES_${_rv}_LLVM_ENABLE_RUNTIMES "compiler-rt" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_CMAKE_SYSTEM_NAME "Linux" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_CMAKE_SYSTEM_PROCESSOR "riscv64" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_CMAKE_C_FLAGS "${_rv_compile_flags}" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_CMAKE_CXX_FLAGS "${_rv_compile_flags}" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_CMAKE_EXE_LINKER_FLAGS "-fuse-ld=lld ${_rv_link_flags}" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_CMAKE_SHARED_LINKER_FLAGS "-fuse-ld=lld ${_rv_link_flags}" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_CMAKE_MODULE_LINKER_FLAGS "-fuse-ld=lld ${_rv_link_flags}" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_SANITIZERS ON CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_SANITIZERS_TO_BUILD "ubsan_minimal" CACHE STRING "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_XRAY OFF CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_LIBFUZZER OFF CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_PROFILE OFF CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_CTX_PROFILE OFF CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_MEMPROF OFF CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_COPYPROF OFF CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_ORC OFF CACHE BOOL "" FORCE)
set(RUNTIMES_${_rv}_COMPILER_RT_BUILD_GWP_ASAN OFF CACHE BOOL "" FORCE)
