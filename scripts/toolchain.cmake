set(CMAKE_BUILD_TYPE "Release" CACHE STRING "" FORCE)
set(LLVM_ENABLE_ASSERTIONS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_PROJECTS "clang;lld" CACHE STRING "" FORCE)
set(LLVM_ENABLE_RUNTIMES "compiler-rt" CACHE STRING "" FORCE)

# uname is needed before project() initializes CMAKE_SYSTEM_{NAME,PROCESSOR}
execute_process(
  COMMAND uname -s
  OUTPUT_VARIABLE _lmc_host_os
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
)
execute_process(
  COMMAND uname -m
  OUTPUT_VARIABLE _lmc_host_arch
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
)

if(NOT DEFINED LLVM_TARGETS_TO_BUILD OR LLVM_TARGETS_TO_BUILD STREQUAL "")
  if(_lmc_host_arch MATCHES "^(arm64|aarch64)$")
    set(LLVM_TARGETS_TO_BUILD "AArch64" CACHE STRING "" FORCE)
  elseif(_lmc_host_os STREQUAL "Linux" AND _lmc_host_arch MATCHES "^(x86_64|amd64)$")
    set(LLVM_TARGETS_TO_BUILD "X86;RISCV" CACHE STRING "" FORCE)
  elseif(_lmc_host_arch MATCHES "^(x86_64|amd64)$")
    set(LLVM_TARGETS_TO_BUILD "X86" CACHE STRING "" FORCE)
  else()
    set(LLVM_TARGETS_TO_BUILD "Native" CACHE STRING "" FORCE)
  endif()
endif()

set(CLANG_ENABLE_CIR OFF CACHE BOOL "" FORCE)
set(CLANG_ENABLE_STATIC_ANALYZER OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_BINDINGS OFF CACHE BOOL "" FORCE)
set(LLVM_ENABLE_OCAMLDOC OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LLVM_INCLUDE_DOCS OFF CACHE BOOL "" FORCE)
set(LLVM_APPEND_VC_REV OFF CACHE BOOL "" FORCE)

# compiler-rt adds lib/ubsan whenever COMPILER_RT_BUILD_SANITIZERS=ON, so omit ubsan from COMPILER_RT_SANITIZERS_TO_BUILD
set(COMPILER_RT_BUILD_BUILTINS ON CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_SANITIZERS ON CACHE BOOL "" FORCE)
set(COMPILER_RT_SANITIZERS_TO_BUILD "asan;asan_abi;ubsan_minimal" CACHE STRING "" FORCE)
set(COMPILER_RT_BUILD_XRAY OFF CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_LIBFUZZER OFF CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_PROFILE OFF CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_CTX_PROFILE OFF CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_MEMPROF OFF CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_COPYPROF OFF CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_ORC OFF CACHE BOOL "" FORCE)
set(COMPILER_RT_BUILD_GWP_ASAN OFF CACHE BOOL "" FORCE)

if(_lmc_host_os STREQUAL "Linux")
  find_program(_lmc_lld ld.lld)
  if(_lmc_lld)
    set(LLVM_USE_LINKER "lld" CACHE STRING "")
  endif()
  if(_lmc_host_arch MATCHES "^(x86_64|amd64)$" AND EXISTS "/usr/riscv64-linux-gnu/include/stdio.h")
    include("${CMAKE_CURRENT_LIST_DIR}/toolchain-riscv64.cmake")
  endif()
elseif(_lmc_host_os STREQUAL "Darwin")
  set(COMPILER_RT_ENABLE_IOS OFF CACHE BOOL "" FORCE)
  set(COMPILER_RT_ENABLE_WATCHOS OFF CACHE BOOL "" FORCE)
  set(COMPILER_RT_ENABLE_TVOS OFF CACHE BOOL "" FORCE)
  set(COMPILER_RT_ENABLE_XROS OFF CACHE BOOL "" FORCE)
endif()

set(LLVM_PARALLEL_LINK_JOBS "2" CACHE STRING "")

find_program(_lmc_ccache ccache)
if(_lmc_ccache)
  set(LLVM_CCACHE_BUILD ON CACHE BOOL "" FORCE)
endif()
